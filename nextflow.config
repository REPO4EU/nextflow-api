def envInt = { String name, int defaultValue ->
    def value = System.getenv(name)
    if (value == null || value.trim().isEmpty()) {
        return defaultValue
    }

    def parsedValue = value.toInteger()
    if (parsedValue < 1) {
        throw new IllegalArgumentException("${name} must be at least 1")
    }
    return parsedValue
}

def localCpus = envInt('NEXTFLOW_LOCAL_CPUS', 5)
def processSingleCpus = envInt('NEXTFLOW_PROCESS_SINGLE_CPUS', 1)
def processLowCpus = envInt('NEXTFLOW_PROCESS_LOW_CPUS', 2)
def processMediumCpus = envInt('NEXTFLOW_PROCESS_MEDIUM_CPUS', 3)
def processHighCpus = envInt('NEXTFLOW_PROCESS_HIGH_CPUS', 5)

cleanup = true

executor {
    $local {
        cpus = localCpus
    }
}

process {
    withLabel:process_single { cpus = processSingleCpus }
    withLabel:process_low    { cpus = processLowCpus }
    withLabel:process_medium { cpus = processMediumCpus }
    withLabel:process_high   { cpus = processHighCpus }
}